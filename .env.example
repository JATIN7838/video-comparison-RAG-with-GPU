# ENVIRONMENT=dev
# HOST=0.0.0.0
# PORT=9000

# Shared secret the backend sends in the `X-API-Key` header.
# If unset, auth is disabled (dev only).
RETRIEVAL_API_KEY=change-me

# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_BATCH_SIZE=30

# CHUNK_SIZE=800
# CHUNK_OVERLAP=200
# WINDOW_SIZE=1500

# Leave QDRANT_URL unset to use embedded on-disk Qdrant at QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=

# Model backend: "local" (load dense + cross-encoder on GPU/CPU)
#             or "huggingface" (call HF Inference Endpoints; no GPU/torch needed).
# BM25/sparse always runs locally on CPU regardless of this setting.
MODEL_BACKEND=local

# Required only when MODEL_BACKEND=huggingface:
# HF_TOKEN=
# HF_EMBEDDING_ENDPOINT_URL=https://xxxx.endpoints.huggingface.cloud
# HF_RERANKER_ENDPOINT_URL=https://yyyy.endpoints.huggingface.cloud
# EMBEDDING_DIM=1024